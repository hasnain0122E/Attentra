# ─────────────────────────────────────────────────────
# Attentra — Environment Variables
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env with real keys.

# ─────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────

DATABASE_URL=

# ─────────────────────────────────────────────────────
# AUTHENTICATION (NextAuth.js)
# ─────────────────────────────────────────────────────

AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin:  http://localhost:3000
# Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────
# PROVIDER API KEYS (server-side only — never NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─────────────────────────────────────────────────────
# BLUEMINDS (Phase 7 Step 2 — execution adapter)
# ─────────────────────────────────────────────────────

BLUEMINDS_API_KEY=
BLUEMINDS_BASE_URL=https://api.bluesminds.com/v1
BLUEMINDS_TIMEOUT_MS=30000

# Optional: model used for live integration tests
BLUEMINDS_TEST_MODEL=

# ─────────────────────────────────────────────────────
# Phase 5: Model Registry + Pricing Intelligence
# ─────────────────────────────────────────────────────

# Currency conversion (Architecture.md §9)
# USD_TO_PKR_RATE=

# Vercel Cron Job authentication (Phase 5 — pricing sync every 10 hours)
# Generate a random secret: openssl rand -hex 32
# CRON_SECRET=

# Consumer
# CONSUMER_BASELINE_MODEL_ID=

# ─────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────

# ENABLE_FALLBACK_ROUTING=true
# LOG_PROMPTS=false
# API_RATE_LIMIT_PER_MINUTE=60
# CONSUMER_RATE_LIMIT_PER_MINUTE=10

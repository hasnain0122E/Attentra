# ─────────────────────────────────────────────────────
# Attentra — Environment Variables
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env with real keys.

# ─────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────

DATABASE_URL=

# ─────────────────────────────────────────────────────
# AUTHENTICATION (NextAuth.js)
# ─────────────────────────────────────────────────────

AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin:  http://localhost:3000
# Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────
# PROVIDER API KEYS (server-side only — never NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─────────────────────────────────────────────────────
# Phase 5: Model Registry + Pricing Intelligence
# ─────────────────────────────────────────────────────

# Currency conversion (Architecture.md §9)
# USD_TO_PKR_RATE=

# Display currency for user-facing monetary values (Phase 12.12.2)
# All internal calculations remain in USD; conversion is presentation-only.
# NEXT_PUBLIC_ prefix required for client-component access.
NEXT_PUBLIC_DISPLAY_CURRENCY=PKR
NEXT_PUBLIC_USD_TO_PKR_RATE=277

# Vercel Cron Job authentication (Phase 5 — pricing sync every 10 hours)
# Generate a random secret: openssl rand -hex 32
# CRON_SECRET=

# Consumer baseline model identifier (Phase 12.12)
# Used for personal/consumer request cost comparison.
# Must match an active model's modelIdentifier in the registry.
CONSUMER_BASELINE_MODEL="claude-sonnet-5"

# ─────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────

# ENABLE_FALLBACK_ROUTING=true
# LOG_PROMPTS=false
# API_RATE_LIMIT_PER_MINUTE=60
# CONSUMER_RATE_LIMIT_PER_MINUTE=10

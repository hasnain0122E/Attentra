# ─────────────────────────────────────────────────────
# Attentra — Environment Variables
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env or .env.local with real keys.
# Every variable below is verified against actual source usage.

# ─────────────────────────────────────────────────────
# DATABASE (Prisma — prisma/schema.prisma)
# ─────────────────────────────────────────────────────
# PostgreSQL connection string. Required for build + runtime.
DATABASE_URL=

# ─────────────────────────────────────────────────────
# AUTHENTICATION (Auth.js v5 — src/auth.ts)
# ─────────────────────────────────────────────────────
# Secret used to encrypt/decrypt JWT sessions (implicit Auth.js v5 convention).
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin:  http://localhost:3000
# Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────
# PROVIDER API KEYS (server-side only — never NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────
# Used by execution adapters (src/lib/providers) and model
# catalog discovery (src/lib/catalog/discovery.ts).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─────────────────────────────────────────────────────
# PRICING SYNC CRON (src/app/api/internal/pricing-sync)
# ─────────────────────────────────────────────────────
# Vercel Cron (vercel.json) sends Authorization: Bearer CRON_SECRET.
# If unset, the sync endpoint accepts unauthenticated POSTs — always set
# this in production. Generate: openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────
# COST INTELLIGENCE + BILLING BASELINE
# ─────────────────────────────────────────────────────
# Consumer baseline model identifier used for verified-savings
# comparison (src/lib/cost-intelligence, src/lib/billing).
# Must match an active model's modelIdentifier in the registry.
CONSUMER_BASELINE_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────
# DISPLAY CURRENCY (client — src/lib/currency/display-currency.ts)
# ─────────────────────────────────────────────────────
# Presentation-only. All internal calculations remain in USD.
# NEXT_PUBLIC_ prefix required for client-component access.
NEXT_PUBLIC_DISPLAY_CURRENCY=PKR
NEXT_PUBLIC_USD_TO_PKR_RATE=277

# ─────────────────────────────────────────────────────
# LOCAL TEST GATE ONLY — NOT FOR PRODUCTION
# ─────────────────────────────────────────────────────
# When set to "true", enables live provider E2E tests
# (src/__tests__/e2e/attentra-e2e.test.ts). These tests call real
# provider APIs. Never set this in a production environment.
# RUN_LIVE_PROVIDER_TESTS=

# ─────────────────────────────────────────────────────
# Framework-managed (do not set manually)
# ─────────────────────────────────────────────────────
# NODE_ENV — set by Next.js (development / production)

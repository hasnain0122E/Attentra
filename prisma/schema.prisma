// Attentra — Prisma Schema
// Phase 5: Dynamic Model Registry + Pricing Intelligence
// Architecture.md v2.0 §5, §7, §9, §10

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────
// AUTH MODELS (Auth.js v5 + Prisma Adapter)
// ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  requests    Request[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────
// BUSINESS
// ─────────────────────────────────────────────────────

model Business {
  id              String   @id @default(cuid())
  name            String
  baselineModelId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  baselineModel Model?       @relation("BusinessBaseline", fields: [baselineModelId], references: [id], onDelete: SetNull)
  memberships   Membership[]
  apiKeys       ApiKey[]
  requests      Request[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  businessId String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

// ─────────────────────────────────────────────────────
// API KEYS
// ─────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  businessId String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requests Request[]
}

// ─────────────────────────────────────────────────────
// PROVIDERS + MODELS
// ─────────────────────────────────────────────────────

model Provider {
  id                String    @id @default(cuid())
  name              String    @unique
  status            ProviderStatus @default(ACTIVE)
  pricingSourceUrl  String?   @db.Text
  lastPricingSyncAt DateTime?
  createdAt         DateTime  @default(now())

  models        Model[]
  pricingSyncs  PricingSyncLog[]
}

model Model {
  id                String      @id @default(cuid())
  providerId        String
  modelIdentifier   String
  displayName       String
  capabilities      String[]
  tier              ModelTier?
  contextWindow     Int?
  inputPricePer1k   Decimal     @db.Decimal(12, 8)
  outputPricePer1k  Decimal     @db.Decimal(12, 8)
  expectedLatencyMs Int?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  provider         Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  pricingSnapshots PricingSnapshot[]
  requests         Request[]
  businessBaseline Business[]        @relation("BusinessBaseline")

  @@unique([providerId, modelIdentifier])
}

// ─────────────────────────────────────────────────────
// PRICING SNAPSHOTS
// ─────────────────────────────────────────────────────

model PricingSnapshot {
  id                    String    @id @default(cuid())
  modelId               String
  inputPricePer1k       Decimal   @db.Decimal(12, 8)
  outputPricePer1k      Decimal   @db.Decimal(12, 8)
  cachedInputPricePer1k Decimal?  @db.Decimal(12, 8)
  batchInputPricePer1k  Decimal?  @db.Decimal(12, 8)
  batchOutputPricePer1k Decimal?  @db.Decimal(12, 8)
  pricingDimensions     Json?
  source                String?
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  createdAt             DateTime  @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────
// PRICING SYNC LOG
// ─────────────────────────────────────────────────────

model PricingSyncLog {
  id           String     @id @default(cuid())
  providerId   String
  status       SyncStatus
  modelsSynced Int        @default(0)
  pricesUpdated Int       @default(0)
  error        String?    @db.Text
  triggeredBy  String     @default("manual")
  startedAt    DateTime   @default(now())
  completedAt  DateTime?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────
// REQUESTS + ROUTING
// ─────────────────────────────────────────────────────

model Request {
  id                String        @id @default(cuid())
  userId            String?
  businessId        String?
  apiKeyId          String?
  prompt            String?       @db.Text
  response          String?       @db.Text
  taskType          String?
  complexity        Complexity?
  status            RequestStatus @default(PENDING)
  selectedProviderId String?
  selectedModelId   String?
  inputTokens       Int?
  outputTokens      Int?
  latencyMs         Int?
  actualCost        Decimal?      @db.Decimal(12, 8)
  baselineCost      Decimal?      @db.Decimal(12, 8)
  savings           Decimal?      @db.Decimal(12, 8)
  savingsPercentage Decimal?      @db.Decimal(8, 4)
  createdAt         DateTime      @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  business        Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  apiKey          ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  selectedModel   Model?           @relation(fields: [selectedModelId], references: [id], onDelete: SetNull)
  routingDecision RoutingDecision?
}

model RoutingDecision {
  id              String   @id @default(cuid())
  requestId       String   @unique
  taskType        String?
  complexity      Complexity?
  candidateModels Json?
  selectedModelId String?
  score           Decimal? @db.Decimal(8, 4)
  reason          String?  @db.Text
  createdAt       DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────

enum MembershipRole {
  OWNER
  MEMBER
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  DEGRADED
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT_ERROR
  PROVIDER_ERROR
}

enum ModelTier {
  LIGHT
  MID
  HEAVY
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}
